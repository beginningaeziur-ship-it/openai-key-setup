<!--
  ═══════════════════════════════════════════════════════════════════════
  ANDROID MANIFEST ADDITIONS — Aria Interpreter
  ═══════════════════════════════════════════════════════════════════════

  HOW TO USE:
  1. Open android/app/src/main/AndroidManifest.xml
  2. Add the <uses-permission> lines inside the root <manifest> tag
  3. Add the <service> block inside the <application> tag
  ═══════════════════════════════════════════════════════════════════════
-->

<!-- ── Permissions (inside root <manifest> tag) ───────────────────── -->

<!-- Microphone — required for voice input / speech recognition -->
<uses-permission android:name="android.permission.RECORD_AUDIO" />

<!-- Contacts — lets Aria call/message people by name -->
<uses-permission android:name="android.permission.READ_CONTACTS" />

<!-- Internet — required for AI API calls -->
<uses-permission android:name="android.permission.INTERNET" />

<!-- Accessibility service binding -->
<uses-permission
    android:name="android.permission.BIND_ACCESSIBILITY_SERVICE"
    tools:ignore="ProtectedPermissions" />

<!-- Audio playback settings for TTS -->
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

<!-- Vibration — optional haptic feedback on command confirmation -->
<uses-permission android:name="android.permission.VIBRATE" />

<!-- ── Accessibility Service (inside <application> tag) ───────────── -->

<!-- Gives Aria read+control access to every app on the device -->
<service
    android:name=".interpreter.InterpreterAccessibilityService"
    android:exported="true"
    android:label="@string/accessibility_service_label"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/interpreter_accessibility_service" />
</service>

<!-- ── WebView configuration (inside <application> tag) ──────────── -->

<!-- Allow WebView to use microphone (required for Web Speech API) -->
<meta-data
    android:name="android.webkit.WebView.EnableSafeBrowsing"
    android:value="false" />

<!--
  Also add this attribute to your <application> tag:
    android:usesCleartextTraffic="true"   (for dev/localhost only)

  And add this to your MainActivity's WebView setup:
    webView.settings.mediaPlaybackRequiresUserGesture = false
    webView.settings.javaScriptEnabled = true
-->
