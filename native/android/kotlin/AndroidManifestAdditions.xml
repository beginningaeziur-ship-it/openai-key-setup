<!--
  Add these entries to android/app/src/main/AndroidManifest.xml
  inside the <application> tag.
-->

<!-- Accessibility Service — lets Aria read and control any app -->
<service
    android:name=".interpreter.InterpreterAccessibilityService"
    android:exported="true"
    android:label="@string/accessibility_service_label"
    android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
    <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
    </intent-filter>
    <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/interpreter_accessibility_service" />
</service>

